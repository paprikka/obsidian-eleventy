{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "typeRoots": ["./build/types", "./node_modules/@types"]
  },
  "include": ["build/**/*"],
  "exclude": ["node_modules", "_site"]
}
